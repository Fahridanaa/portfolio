---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import SocialButton from "@/components/ui/SocialButton.astro";
import me from "@/../public/assets/me.jpg";
import ExperienceCard from "@/components/ui/ExperienceCard";
import BlogEntryCard from "@/components/ui/BlogEntryCard.astro";
import { SOCIAL_LINKS } from "@/data/site";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import ArtGrid from "@/components/ui/ArtGrid.astro";
import MiniProjectScrap from "@/components/ui/MiniProjectScrap.astro";
import ProjectGridPlaceholder from "@/components/ui/ProjectGridPlaceholder.astro";
import { getBlogEntries, getExperiences, getProjects } from "@/lib/content";
import { DEFAULT_MODE } from "@/utils/mode";
import { STICKY_NOTE_CLASSES } from "@/utils/blog";

const sortedPersonalProjects = await getProjects();
const projectGridCols = 3;
const projectTotalSlots =
	Math.ceil((sortedPersonalProjects.length + 1) / projectGridCols) *
	projectGridCols;
const projectPlaceholderCount = Math.max(
	0,
	projectTotalSlots - sortedPersonalProjects.length - 1
);

const blogEntries = await getBlogEntries();
const workBlogEntries = blogEntries
	.filter((entry) => entry.data.mode === DEFAULT_MODE)
	.slice(0, 5);
const personalBlogEntries = blogEntries
	.filter((entry) => entry.data.mode !== DEFAULT_MODE)
	.slice(0, 5);
const personalBlogPlaceholders = Array.from({
	length: Math.max(0, 5 - personalBlogEntries.length),
});

const sortedExperiences = await getExperiences();

const currentYear = new Date().getFullYear();
---

<Layout title="Fahridana Ahmad Rayyansyah">
	<div
		class="notebook-sheet mx-auto max-w-7xl overflow-hidden px-5 sm:px-8 lg:px-12">

		<article id="hero" class="notebook-section py-10 md:py-16">
			<section
				class="grid w-full items-center gap-8 lg:grid-cols-[1.15fr_0.85fr]">
				<div class="min-w-0 space-y-6">
					<div class="space-y-3">
						<h1
							class="text-3xl text-pretty font-black leading-[0.98] text-brand-ink sm:text-4xl lg:text-5xl">
							<span class="text-nowrap"><span class="ink-underline font-black text-brand-green">Fahri</span>dana</span> Ahmad Rayyansyah
						</h1>
						<p
							class="text-xl font-semibold leading-snug text-brand-graphite sm:text-2xl">
							<span class="ink-underline font-black text-brand-green">
								Software Developer
							</span>
						</p>
					</div>
					<div
						class="max-w-[58ch] space-y-3 text-base leading-relaxed text-brand-graphite sm:text-lg">
						<p>
							I'm a software engineer with about a year of experience.
							I build things on the internet, move across frontend and
							backend, and dip into infra when needed. I like keeping
							things simple. Lately I've been diving into AI and learning
							to harness it instead of letting it take the wheel.
						</p>
					</div>
					<div class="flex flex-wrap gap-3" aria-label="Social links">
						{
							SOCIAL_LINKS.map((item) => (
								<SocialButton
									href={item.href}
									title={item.title}
									ariaLabel={item.ariaLabel}
									iconSrc={item.iconSrc}
								/>
							))
						}
					</div>
				</div>

				<div class="relative mx-auto w-full max-w-sm">
					<div>
						<div class="camera-print">
							<span class="camera-pin" aria-hidden="true"></span>
							<Image
								src={me}
								alt="Portrait of Fahridana Ahmad Rayyansyah"
								loading="eager"
								width={2048}
								height={2048}
								class="aspect-square w-full rounded-sm object-cover"
							/>
							<p class="camera-caption">me</p>
						</div>
						<div
							class="sticky-note absolute -bottom-4 -left-4 rotate-12 max-w-56 p-4 text-sm font-semibold leading-relaxed text-brand-ink">
							<p>
							  This is me :)
							</p>
						</div>
					</div>
				</div>
			</section>
		</article>

		<section id="experience" data-mode-block="work" class="notebook-section compact-section">
			<SectionHeader title="Experience" spacer />
			<div class="experience-list mt-6">
				{
					sortedExperiences.map((experience) => (
						<div class="experience-item">
							<ExperienceCard experience={experience.data} client:load />
						</div>
					))
				}
			</div>
		</section>

		<section id="projects" data-mode-block="work" class="notebook-section compact-section">
			<SectionHeader title="Projects" spacer />
			<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{
					sortedPersonalProjects.map((project) => (
						<MiniProjectScrap project={project.data} slug={project.slug} />
					))
				}
				{
					Array.from({ length: projectPlaceholderCount }).map(() => (
						<ProjectGridPlaceholder />
					))
				}
				<a
					href="/projects"
					class="paper-scrap scrap-no-tape paper-lift group flex min-h-40 flex-col items-center justify-center gap-3 p-5 text-center text-brand-ink"
				>
					<p
						class="font-mono text-[0.68rem] font-bold uppercase tracking-normal text-brand-graphite"
					>
						project index
					</p>
					<div class="space-y-3">
						<h3
							class="text-pretty text-2xl font-black leading-tight"
						>
							All Projects
						</h3>
						<p
							class="text-sm leading-relaxed text-brand-graphite"
						>
							Open the full stack of built things.
						</p>
					</div>
					<p
						class="font-mono text-xs font-black uppercase tracking-normal text-brand-green"
					>
						open list →
					</p>
				</a>
			</div>
		</section>

		<section id="art" data-mode-block="personal" class="notebook-section compact-section">
			<SectionHeader title="Art & Drawings" spacer />
			<ArtGrid limit={5} />
		</section>

		<section id="blog" class="notebook-section compact-section">
			<div class="mb-6">
				<div>
					<SectionHeader title="Latest Note" />
				</div>
			</div>
			<div class="mt-8 grid gap-5 md:grid-cols-3">
				{
					workBlogEntries.map((entry, index) => (
						<BlogEntryCard entry={entry} index={index} />
					))
				}
				{
					workBlogEntries.length === 0 && (
						<article data-mode-block="work" class="sticky-note sticky-note-center flex min-h-56 flex-col p-4">
							<div class="relative z-[1] flex flex-1 flex-col justify-between gap-2">
								<p class="font-mono text-[0.68rem] font-bold uppercase tracking-normal text-brand-graphite">
									work notes
								</p>
								<div class="space-y-2">
									<h3 class="text-pretty text-3xl font-black leading-tight text-brand-ink">
										Quiet here
									</h3>
									<p class="break-words text-sm leading-relaxed text-brand-graphite">
										No work notes yet. Flip to Personal for notebook entries.
									</p>
								</div>
								<p class="font-mono text-xs font-black uppercase tracking-normal text-brand-green">
									empty desk
								</p>
							</div>
						</article>
					)
				}
				{
					personalBlogEntries.map((entry, index) => (
						<BlogEntryCard entry={entry} index={index} />
					))
				}
				{
					personalBlogPlaceholders.map((_, index) => {
						const slotIndex = personalBlogEntries.length + index;
						const tiltClass = STICKY_NOTE_CLASSES[slotIndex];

						return (
							<article data-mode-block="personal" class={`sticky-note ${tiltClass} flex min-h-56 flex-col p-4`}>
								<div class="relative z-[1] flex flex-1 flex-col justify-between gap-2">
									<p class="font-mono text-[0.68rem] font-bold uppercase tracking-normal text-brand-graphite">
										empty sticky
									</p>
									<div class="space-y-2">
										<h3 class="text-pretty text-3xl font-black leading-tight text-brand-ink">
											Soon
										</h3>
										<p class="break-words text-sm leading-relaxed text-brand-graphite">
											A note is still being scribbled. It can stay messy until it is ready.
										</p>
									</div>
									<p class="font-mono text-xs font-black uppercase tracking-normal text-brand-green">
										draft pile
									</p>
								</div>
							</article>
						);
					})
				}
				<div class="sticky-note-stack min-h-56 self-start">
					<span class="sticky-note-stack-layer sticky-note-stack-layer-back" aria-hidden="true"></span>
					<span class="sticky-note-stack-layer sticky-note-stack-layer-mid" aria-hidden="true"></span>
					<a
						href="/blog"
						class={`sticky-note ${STICKY_NOTE_CLASSES[5]} sticky-note-nav sticky-note-stack-top flex min-h-44 flex-col justify-between p-4 text-brand-ink`}
					>
						<p class="relative z-[1] font-mono text-[0.68rem] font-bold uppercase tracking-normal text-brand-graphite">
							note index
						</p>
						<div class="relative z-[1] space-y-2">
							<h3 class="text-pretty text-2xl font-black leading-tight">
								All Notes
							</h3>
							<p class="text-sm leading-relaxed text-brand-graphite">
								Open the full stack of public notebook entries.
							</p>
						</div>
						<p class="relative z-[1] font-mono text-xs font-black uppercase tracking-normal text-brand-green">
							open list
						</p>
					</a>
				</div>
			</div>
		</section>

		<footer class="mx-auto max-w-5xl py-10 text-center text-sm text-brand-graphite">
			<p class="font-semibold">
				&copy; {currentYear} Fahridana Ahmad Rayyansyah. Made like a notebook,
				shipped like a website.
			</p>
		</footer>
	</div>
</Layout>
