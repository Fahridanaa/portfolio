---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import MiniProjectScrap from "@/components/ui/MiniProjectScrap.astro";
import type { Project } from "@/models/project";

const projects = (await getCollection("projects")).sort(
	(a: Project, b: Project) => (a.data.date > b.data.date ? -1 : 1)
);
---

<Layout title="Projects / Fahridana Ahmad Rayyansyah">
	<div
		class="notebook-sheet mx-auto min-h-dvh w-full max-w-6xl overflow-hidden px-5 sm:px-8 lg:px-12">
		<article class="notebook-section mx-auto max-w-5xl pt-16">
			<header class="mb-10 space-y-5">
				<p class="sketch-label">project index</p>
				<h1
					class="max-w-[11ch] text-pretty text-5xl font-black leading-[0.98] text-brand-ink sm:text-6xl">
					Projects
				</h1>
				<p class="max-w-[62ch] text-lg leading-relaxed text-brand-graphite">
					Things I built. Small experiments, practical tools, and pages
					that survived contact with real users.
				</p>
			</header>

			<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{
					projects.map((project) => (
						<MiniProjectScrap project={project.data} slug={project.slug} />
					))
				}
			</div>
		</article>
	</div>
</Layout>
