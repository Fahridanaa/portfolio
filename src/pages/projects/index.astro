---
import { getProjectGroups } from "@/lib/content";
import Layout from "@/layouts/Layout.astro";
import MiniProjectScrap from "@/components/ui/MiniProjectScrap.astro";
import ProjectGroupHeader from "@/components/ui/ProjectGroupHeader.astro";
import { OPEN_SOURCE_REPOS } from "@/data/open-source";
import { PROJECT_GROUPS } from "@/data/project-groups";
import { byNewestDate } from "@/utils/sort";
import type { CollectionEntry } from "astro:content";

const groups = await getProjectGroups();
const projectTotal =
	groups.personal.length + groups.openSource.length + groups.university.length;

const coverFirstThenNewest = (
	a: CollectionEntry<"projects">,
	b: CollectionEntry<"projects">
) =>
	Number(b.data.hasImage) - Number(a.data.hasImage) || byNewestDate(a, b);

const sections = [
	{
		id: "personal",
		...PROJECT_GROUPS.personal,
		count: `${groups.personal.length} projects`,
		projects: [...groups.personal].sort(coverFirstThenNewest),
	},
	{
		id: "open-source",
		...PROJECT_GROUPS.openSource,
		count: `${groups.openSource.length} projects`,
		projects: [...groups.openSource].sort(coverFirstThenNewest),
	},
	{
		id: "university",
		...PROJECT_GROUPS.university,
		count: `${groups.university.length} projects`,
		projects: [...groups.university].sort(coverFirstThenNewest),
	},
];

const mergedPrs = (repo: string | null) =>
	OPEN_SOURCE_REPOS.find((item) => item.name === repo)?.pulls.length;
---

<Layout
	title="Projects"
	description="Web applications, open-source contributions, and university projects by Fahridana Ahmad Rayyansyah, grouped by where the work came from."
	image="/projects/og.png"
>
	<div
		class="notebook-sheet mx-auto min-h-dvh w-full overflow-hidden px-5 sm:px-8 lg:px-12"
	>
		<article class="notebook-section page-top mx-auto max-w-5xl">
			<header class="mb-12 space-y-5">
				<p class="sketch-label">project index</p>
				<h1
					class="max-w-[11ch] text-pretty text-5xl font-black leading-[0.98] text-brand-ink sm:text-6xl"
				>
					Projects
				</h1>
				<p class="max-w-[62ch] text-lg leading-relaxed text-brand-graphite">
					{projectTotal} projects, grouped by where the work came from.
				</p>
				<nav aria-label="Project groups" class="flex flex-wrap gap-2 pt-1">
					<a
						href="#personal"
						aria-label={`Personal projects, ${groups.personal.length}`}
						class="sketch-label gap-1.5 text-xs transition-colors hover:bg-brand-highlighter/80"
					>
						{PROJECT_GROUPS.personal.label}
						<span class="text-brand-green">{groups.personal.length}</span>
					</a>
					<a
						href="#open-source"
						aria-label={`Open source, ${groups.openSource.length} projects`}
						class="sketch-label gap-1.5 text-xs transition-colors hover:bg-brand-highlighter/80"
					>
						{PROJECT_GROUPS.openSource.label}
						<span class="text-brand-green">{groups.openSource.length}</span>
					</a>
					<a
						href="#university"
						aria-label={`University projects, ${groups.university.length}`}
						class="sketch-label gap-1.5 text-xs transition-colors hover:bg-brand-highlighter/80"
					>
						{PROJECT_GROUPS.university.label}
						<span class="text-brand-green">{groups.university.length}</span>
					</a>
				</nav>
			</header>

			<div class="space-y-16">
				{
					sections.map((section) => (
						<section id={section.id} class="scroll-mt-24">
							<ProjectGroupHeader
								index={section.index}
								title={section.title}
								count={section.count}
								blurb={section.blurb}
							/>
							<div class="mt-6 grid gap-4 sm:grid-cols-2">
								{section.projects.map((project) => (
									<MiniProjectScrap
										project={project.data}
										slug={project.id}
										mergedPrs={mergedPrs(project.data.repo)}
									/>
								))}
							</div>
						</section>
					))
				}
			</div>
		</article>
	</div>
</Layout>
