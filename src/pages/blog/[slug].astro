---
import { render } from "astro:content";
import { getBlogEntries } from "@/lib/content";
import Layout from "@/layouts/Layout.astro";
import BlogBanner from "@/components/ui/BlogBanner.astro";
import PaperNav from "@/components/ui/PaperNav.astro";
import ReadingFooter from "@/components/ui/ReadingFooter.astro";
import BlogTags from "@/components/ui/BlogTags.astro";
import NotePager from "@/components/ui/NotePager.astro";
import {
	estimateReadingTime,
	formatBlogDate,
	type BlogEntry,
} from "@/utils/blog";
import { ogImageVersion } from "@/utils/og";
import { blogPostingJsonLd } from "@/utils/structured-data";
import { SITE_NAME } from "@/data/site";

export async function getStaticPaths() {
	const entries = await getBlogEntries();

	return entries.map((entry, index) => ({
		params: { slug: entry.id },
		props: {
			entry,
			newer: entries[index - 1],
			older: entries[index + 1],
		},
	}));
}

interface Props {
	entry: BlogEntry;
	newer?: BlogEntry;
	older?: BlogEntry;
}

const { entry, newer, older } = Astro.props;
const { Content, headings } = await render(entry);
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const readingTime = estimateReadingTime(entry.body);
const hasBanner = Boolean(entry.data.banner);
const ogVersion = ogImageVersion(entry.data);
const ogImage = `/blog/${entry.id}/og.png?v=${ogVersion}`;
---

<Layout
	title={entry.data.title}
	section="Blog"
	description={entry.data.description}
	image={ogImage}
	imageAlt={`Text preview for ${entry.data.title}`}
	type="article"
	canonical={`/blog/${entry.id}/`}
	lang={entry.data.lang}
	hideNavbar
	ownMain
	jsonLd={blogPostingJsonLd(entry, {
		site: Astro.site ?? Astro.url,
		image: ogImage,
		authorName: SITE_NAME,
	})}>
	<div
		class="notebook-sheet notebook-sheet-plain mx-auto min-h-dvh w-full overflow-clip px-5 sm:px-8 lg:px-12">
		<PaperNav backHref="/blog/" label="Blog navigation" />

		<main id="main-content" tabindex="-1" class="relative min-h-dvh">
			<article class="notebook-section mx-auto max-w-5xl pt-16">
				<BlogBanner entry={entry} />

				<div
					class:list={[
						"lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:items-start lg:gap-x-8 xl:grid-cols-[11rem_minmax(0,1fr)]",
						hasBanner && "mt-8",
					]}>
					<div class="min-w-0 lg:col-start-2">
						<header class:list={["mb-8 pb-6", hasBanner && "soft-divider"]}>
							<div class="max-w-3xl space-y-5">
								<h1
									class="text-pretty text-4xl font-black leading-tight text-brand-ink sm:text-6xl">
									{entry.data.title}
								</h1>
								<p
									class="max-w-[64ch] break-words text-base leading-relaxed text-brand-graphite sm:text-lg">
									{entry.data.description}
								</p>
								<div class="flex flex-wrap items-center gap-3 text-xs font-black uppercase tracking-normal text-brand-graphite">
									<time datetime={entry.data.date.toISOString()}>
										{formatBlogDate(entry.data.date)}
									</time>
									<span aria-hidden="true">/</span>
									<span>{readingTime} min read</span>
									{entry.data.draft && <span class="sketch-label text-[0.62rem]">draft</span>}
								</div>
								<BlogTags tags={entry.data.tags} linked />
							</div>
						</header>

						<section
							class="prose prose-lg reading-measure break-words text-brand-graphite prose-headings:scroll-mt-8 prose-headings:text-brand-ink prose-h2:text-3xl prose-h2:font-black prose-h3:text-2xl prose-h3:font-black prose-a:text-brand-green prose-strong:text-brand-ink prose-ul:list-disc prose-p:my-[0.75em]">
							<Content />
						</section>

						<div class="reading-measure">
							<NotePager older={older} newer={newer} />
						</div>
					</div>
					{
						tocHeadings.length > 0 && (
							<aside class="hidden lg:sticky lg:top-16 lg:col-start-1 lg:row-start-1 lg:block lg:self-start lg:pl-16 xl:pl-0">
								<nav
									aria-label="Table of contents"
									class="border-l border-brand-green/25 pl-4">
									<p class="mb-3 font-mono text-xs font-black uppercase tracking-normal text-brand-green">
										on this note
									</p>
									<ol class="space-y-2 text-sm font-semibold leading-snug text-brand-graphite">
										{tocHeadings.map((heading) => (
											<li class={heading.depth === 3 ? "pl-4" : ""}>
												<a
													href={`#${heading.slug}`}
													class="hover:text-brand-green hover:underline">
													{heading.text}
												</a>
											</li>
										))}
									</ol>
								</nav>
							</aside>
						)
					}
				</div>
			</article>
		</main>

		<ReadingFooter />
	</div>
</Layout>
