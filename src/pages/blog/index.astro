---
import { getBlogEntries } from "@/lib/content";
import Layout from "@/layouts/Layout.astro";
import BlogArchive from "@/components/ui/BlogArchive.astro";
import BlogTagFilter from "@/components/ui/BlogTagFilter.astro";
import { collectBlogTags, groupBlogEntriesByYear } from "@/utils/blog";

const entries = await getBlogEntries();
const yearGroups = groupBlogEntriesByYear(entries);
const tags = collectBlogTags(entries);
---

<Layout
	title="Blog"
	description="Casual notes, small thoughts, debugging stories, and things Fahridana Ahmad Rayyansyah wants to remember out loud."
	image="/blog/og.png"
>
	<div
		class="notebook-sheet mx-auto min-h-dvh w-full overflow-hidden px-5 sm:px-8 lg:px-12">

		<article class="notebook-section page-top mx-auto max-w-5xl">
			<header class="mb-10 space-y-4">
				<h1
					class="max-w-[11ch] text-pretty text-5xl font-black leading-[0.98] text-brand-ink sm:text-6xl">
					Blog Notes
				</h1>
				<p class="max-w-[62ch] text-lg leading-relaxed text-brand-graphite">
					Casual notes, small thoughts, debugging stories, and things I want
					to remember out loud.
				</p>
				<BlogTagFilter tags={tags} total={entries.length} />
				<div class="soft-rule flex-1"></div>
			</header>

			{
				yearGroups.length > 0 ? (
					<BlogArchive yearGroups={yearGroups} />
				) : (
					<div class="paper-scrap scrap-left mx-auto mt-8 max-w-2xl p-6">
						<p class="sketch-label mb-4">empty page</p>
						<p class="text-lg leading-relaxed text-brand-graphite">
							No public notes yet. Drafts can stay here quietly until they are
							ready.
						</p>
					</div>
				)
			}
		</article>
	</div>
</Layout>
