---
import "@/styles/global.css";
import Navbar from "@/components/ui/nav/Navbar.astro";
interface Props {
	title: string;
	description?: string;
	image?: string;
	imageAlt?: string;
	imageType?: string;
	type?: "website" | "article";
	canonical?: string;
	hideNavbar?: boolean;
	lang?: string;
}

const defaultDescription =
	"Fahridana Ahmad Rayyansyah's casual software portfolio.";
const {
	title,
	description = defaultDescription,
	image,
	imageAlt = title,
	imageType = "image/png",
	type = "website",
	canonical,
	hideNavbar = false,
	lang = "en",
} = Astro.props;
const baseUrl = Astro.site ?? Astro.url;
const pageUrl = canonical ? new URL(canonical, baseUrl).toString() : Astro.url.href;
const imageUrl = image ? new URL(image, baseUrl).toString() : undefined;
---

<!doctype html>
<html lang={lang} data-mode="work">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content={description}
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#fbfaf2" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={pageUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:site_name" content="Fahridana Ahmad Rayyansyah" />
		<meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{
			imageUrl && (
				<>
					<meta property="og:image" content={imageUrl} />
					<meta property="og:image:width" content="1200" />
					<meta property="og:image:height" content="630" />
					<meta property="og:image:type" content={imageType} />
					<meta property="og:image:alt" content={imageAlt} />
					<meta name="twitter:image" content={imageUrl} />
					<meta name="twitter:image:alt" content={imageAlt} />
				</>
			)
		}
		<meta name="generator" content={Astro.generator} />
		<script is:inline src="/mode-boot.js"></script>
		<title>{title}</title>
	</head>
	<body>
		<div class="nav-progress" data-nav-progress aria-hidden="true">
			<span></span>
			<span></span>
		</div>
		<a
			href="#main-content"
			class="depth-control fixed left-4 top-4 z-[60] -translate-y-20 rounded-md bg-brand-paper px-4 py-2 font-semibold text-brand-ink transition-transform duration-200 focus-visible:translate-y-0">
			Skip To Content
		</a>
		<main id="main-content" class="relative min-h-dvh">
			{!hideNavbar && <Navbar />}
			<slot />
		</main>
	</body>
	<script>
		import { shouldTrackNavigation } from "@/utils/nav-progress";

		const SHOW_DELAY = 120;
		const STUCK_TIMEOUT = 10000;
		const bar = document.querySelector("[data-nav-progress]");

		let showTimer: number | undefined;

		function clear() {
			window.clearTimeout(showTimer);
			bar?.removeAttribute("data-active");
		}

		document.addEventListener("click", (event) => {
			const anchor =
				event.target instanceof Element
					? event.target.closest("a")
					: null;
			if (!(anchor instanceof HTMLAnchorElement)) return;
			const track = shouldTrackNavigation(
				{
					href: anchor.getAttribute("href"),
					target: anchor.getAttribute("target"),
					download: anchor.getAttribute("download"),
					button: event.button,
					metaKey: event.metaKey,
					ctrlKey: event.ctrlKey,
					shiftKey: event.shiftKey,
					altKey: event.altKey,
				},
				location.href
			);
			if (!track) return;
			clear();
			showTimer = window.setTimeout(
				() => bar?.setAttribute("data-active", ""),
				SHOW_DELAY
			);
			window.setTimeout(clear, STUCK_TIMEOUT);
		});

		addEventListener("pageshow", clear);

		// A bar that is already showing owns the wait. The cross-document snapshot
		// would freeze it mid-stroke, so this navigation skips the transition
		// instead. Fast navigations never reach this point and keep the fade.
		addEventListener("pageswap", (event) => {
			if (!bar?.hasAttribute("data-active")) return;
			event.viewTransition?.skipTransition();
		});
	</script>
</html>
<style is:global>
	html[data-mode="work"] [data-mode-block="personal"],
	html[data-mode="work"] [data-entry-mode="personal"] {
		display: none;
	}

	html[data-mode="personal"] [data-mode-block="work"],
	html[data-mode="personal"] [data-entry-mode="work"] {
		display: none;
	}

	html {
		scroll-behavior: smooth;
		scrollbar-gutter: stable;
	}

	::-webkit-scrollbar {
		width: 10px;
	}

	::-webkit-scrollbar-track {
		background: #eef3e8;
	}

	::-webkit-scrollbar-thumb {
		background-color: #2e5c37;
		border-radius: 10px;
		box-shadow: inset 0 0 0 2px #eef3e8;
	}

	::-webkit-scrollbar-button {
		display: none;
	}
</style>
