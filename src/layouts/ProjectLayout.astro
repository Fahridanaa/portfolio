---
import type { ProjectMeta } from "@/models/project";
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ProjectButton from "@/components/ui/ProjectButton";
import { Code, ExternalLink } from "lucide-react";
import TechStack from "@/components/ui/TechStack.astro";
import PaperNav from "@/components/ui/PaperNav.astro";

export type Props = {
	frontmatter: ProjectMeta;
	slug: string;
};
const { frontmatter, slug } = Astro.props as Props;

const covers = import.meta.glob<{ default: ImageMetadata }>(
	"/public/assets/projects/*/cover.webp",
	{ eager: true }
);
const cover = covers[`/public/assets/projects/${slug}/cover.webp`]?.default;
const showCover = frontmatter.hasImage && Boolean(cover);
---

<Layout title={frontmatter.title} hideNavbar>
	<div
		class="notebook-sheet mx-auto min-h-dvh w-full max-w-6xl overflow-hidden px-5 sm:px-8 lg:px-12">
		<PaperNav backHref="/projects" label="Project navigation" />
		<article class="notebook-section mx-auto max-w-5xl pt-16">
			<header class="max-w-3xl space-y-5">
				<div class="space-y-3">
					<h1
						class="text-pretty text-5xl font-black leading-[0.98] text-brand-ink sm:text-6xl">
						{frontmatter.title}
					</h1>
				</div>
				<p
					class="max-w-[64ch] break-words text-base leading-relaxed text-brand-graphite sm:text-lg">
					{frontmatter.description}
				</p>
			</header>

			{
				showCover ? (
					<div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_16rem] lg:items-start">
						<div class="camera-print min-w-0">
							<span class="camera-pin" aria-hidden="true" />
							<Image
								src={cover}
								alt={frontmatter.title}
								loading="eager"
								width={1600}
								height={800}
								class="w-full rounded-sm"
							/>
							<p class="camera-caption">project cover</p>
						</div>
						<aside class="sticky-note self-start p-4 lg:sticky lg:top-8">
							<div class="relative z-[1] flex flex-col gap-4">
								<div>
									<p class="sketch-label mb-2 text-[0.62rem]">links</p>
									<div class="flex flex-wrap gap-2">
										{frontmatter.demo && (
											<ProjectButton
												href={frontmatter.demo}
												icon={ExternalLink}
												text="Demo"
											/>
										)}
										{frontmatter.sourceClient && (
											<ProjectButton
												href={frontmatter.sourceClient}
												icon={Code}
												text="Client"
											/>
										)}
										{frontmatter.sourceServer && (
											<ProjectButton
												href={frontmatter.sourceServer}
												icon={Code}
												text="API"
											/>
										)}
									</div>
								</div>
								<div>
									<p class="sketch-label mb-2 text-[0.62rem]">stack</p>
									<div class="flex flex-wrap gap-2">
										{frontmatter.stack.map((tech: string) => (
											<TechStack tech={tech} size="small" isLazy={false} />
										))}
									</div>
								</div>
							</div>
						</aside>
					</div>
				) : (
					<div class="sticky-note mt-8 p-4">
						<div class="relative z-[1] grid gap-4 sm:grid-cols-[auto_1fr]">
							<div>
								<p class="sketch-label mb-2 text-[0.62rem]">links</p>
								<div class="flex flex-wrap gap-2">
									{frontmatter.demo && (
										<ProjectButton
											href={frontmatter.demo}
											icon={ExternalLink}
											text="Demo"
										/>
									)}
									{frontmatter.sourceClient && (
										<ProjectButton
											href={frontmatter.sourceClient}
											icon={Code}
											text="Client"
										/>
									)}
									{frontmatter.sourceServer && (
										<ProjectButton
											href={frontmatter.sourceServer}
											icon={Code}
											text="API"
										/>
									)}
								</div>
							</div>
							<div>
								<p class="sketch-label mb-2 text-[0.62rem]">stack</p>
								<div class="flex flex-wrap gap-2">
									{frontmatter.stack.map((tech: string) => (
										<TechStack tech={tech} size="small" isLazy={false} />
									))}
								</div>
							</div>
						</div>
					</div>
				)
			}

			<section
				class="prose prose-lg relative mt-8 max-w-none break-words text-brand-graphite prose-headings:text-brand-ink prose-a:text-brand-green prose-strong:text-brand-ink prose-ul:list-disc prose-p:my-[0.75em]">
				<slot />
			</section>
		</article>
	</div>
</Layout>
