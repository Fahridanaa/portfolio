---
import type { ProjectMeta } from "@/models/project";
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ProjectFacts from "@/components/ui/ProjectFacts.astro";
import PaperNav from "@/components/ui/PaperNav.astro";
import ReadingFooter from "@/components/ui/ReadingFooter.astro";
import ProjectPullRequests from "@/components/ui/ProjectPullRequests.astro";
import { ogImageVersion } from "@/utils/og";

export type Props = {
	frontmatter: ProjectMeta;
	slug: string;
};
const { frontmatter, slug } = Astro.props as Props;

const covers = import.meta.glob<{ default: ImageMetadata }>(
	"/public/assets/projects/*/cover.webp",
	{ eager: true }
);
const cover = covers[`/public/assets/projects/${slug}/cover.webp`]?.default;
const showCover = frontmatter.hasImage && Boolean(cover);
---

<Layout
	title={frontmatter.title}
	section="Projects"
	description={frontmatter.description}
	image={`/projects/${slug}/og.png?v=${ogImageVersion(frontmatter)}`}
	imageAlt={`Text preview for ${frontmatter.title}`}
	hideNavbar
	ownMain
>
	<div
		class="notebook-sheet notebook-sheet-plain mx-auto min-h-dvh w-full overflow-clip px-5 sm:px-8 lg:px-12">
		<PaperNav backHref="/projects/" label="Project navigation" />
		<main id="main-content" tabindex="-1" class="relative min-h-dvh">
			<article class="notebook-section mx-auto max-w-5xl pt-16">
				<header class="max-w-3xl space-y-5">
					<div class="space-y-3">
						<h1
							class="text-pretty text-5xl font-black leading-[0.98] text-brand-ink sm:text-6xl">
							{frontmatter.title}
						</h1>
					</div>
					<p
						class="max-w-[64ch] break-words text-base leading-relaxed text-brand-graphite sm:text-lg">
						{frontmatter.description}
					</p>
				</header>

				{
					showCover ? (
						<div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_16rem] lg:items-start">
							<div class="camera-print min-w-0">
								<span class="camera-pin" aria-hidden="true" />
								<Image
									src={cover}
									alt={frontmatter.title}
									loading="eager"
									width={1600}
									height={800}
									class="w-full rounded-sm"
								/>
								<p class="camera-caption">project cover</p>
							</div>
							<aside class="sticky-note self-start p-4 lg:sticky lg:top-8">
								<div class="relative z-[1] flex flex-col gap-4">
									<ProjectFacts frontmatter={frontmatter} />
								</div>
							</aside>
						</div>
					) : (
						<div class="sticky-note mt-8 w-full p-4 sm:w-fit sm:max-w-full">
							<div class="relative z-[1] grid gap-4 sm:grid-cols-[auto_1fr]">
								<ProjectFacts frontmatter={frontmatter} />
							</div>
						</div>
					)
				}

				<section
					class="prose prose-lg reading-measure relative mt-8 break-words text-brand-graphite prose-headings:text-brand-ink prose-a:text-brand-green prose-strong:text-brand-ink prose-ul:list-disc prose-p:my-[0.75em]">
					<slot />
				</section>

				{frontmatter.repo && (
					<ProjectPullRequests repo={frontmatter.repo} />
				)}
			</article>
		</main>

		<ReadingFooter />
	</div>
</Layout>
