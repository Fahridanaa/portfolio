---
interface Props {
	index: string;
	title: string;
	count: string;
	blurb: string;
}

const { index, title, count, blurb } = Astro.props;
---

<header class="project-group-head">
	<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
		<span class="project-group-stamp" aria-hidden="true">{index}</span>
		<h2
			class="text-pretty text-2xl font-black uppercase leading-none text-brand-ink sm:text-3xl"
		>
			{title}
		</h2>
		<span class="soft-rule hidden min-w-12 flex-1 sm:block"></span>
		<span
			class="font-mono text-[0.68rem] font-bold uppercase tracking-normal text-brand-graphite"
		>
			{count}
		</span>
	</div>
	<p class="mt-3 max-w-[66ch] text-sm leading-relaxed text-brand-graphite sm:text-base">
		{blurb}
	</p>
</header>

<style>
	.project-group-stamp {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border: 1px solid rgba(46, 92, 55, 0.3);
		border-radius: 3px;
		background: rgba(201, 239, 106, 0.55);
		box-shadow: 0 2px 0 rgba(36, 49, 42, 0.12);
		color: var(--ink);
		font-family:
			ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
			monospace;
		font-size: 0.72rem;
		font-weight: 900;
		line-height: 1;
		transform: rotate(-2deg);
	}
</style>
