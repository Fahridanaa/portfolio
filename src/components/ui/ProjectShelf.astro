---
import type { Project } from "@/models/project";
import { OPEN_SOURCE_REPOS } from "@/data/open-source";
import CompactProjectCard from "@/components/ui/CompactProjectCard.astro";
import PullRequestList from "@/components/ui/PullRequestList.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";

interface Props {
	personal: Project[];
}

const { personal } = Astro.props;
const mergedTotal = OPEN_SOURCE_REPOS.reduce(
	(total, repo) => total + repo.pulls.length,
	0,
);
const projectTotal = personal.length + OPEN_SOURCE_REPOS.length;
---

<section id="projects" data-mode-block="work" class="notebook-section compact-section">
	<SectionHeader title="Projects" doodle="projects" />

	<div class="mt-3 flex flex-wrap items-center justify-between gap-2">
		<p
			class="font-mono text-[0.62rem] font-bold uppercase tracking-normal text-brand-graphite"
		>
			{projectTotal} projects · {mergedTotal} merged PRs
		</p>
		<a
			href="/projects"
			class="sketch-label gap-1.5 text-[0.62rem] transition-colors hover:bg-brand-highlighter/80"
		>
			All projects
			<span class="text-brand-green" aria-hidden="true">→</span>
		</a>
	</div>

	<div class="mt-5 grid gap-5 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)] lg:gap-6">
		<div>
			<div
				class="flex items-baseline justify-between gap-2 border-b border-dashed border-brand-ink/25 pb-1.5 font-mono text-[0.62rem] font-bold uppercase tracking-normal text-brand-graphite"
			>
				<span>Personal</span>
				<span>{personal.length} projects</span>
			</div>
			<div class="mt-3 grid gap-3 sm:grid-cols-2">
				{
					personal.map((project) => (
						<CompactProjectCard project={project.data} slug={project.id} />
					))
				}
			</div>
		</div>

		<div>
			<div
				class="flex items-baseline justify-between gap-2 border-b border-dashed border-brand-ink/25 pb-1.5 font-mono text-[0.62rem] font-bold uppercase tracking-normal text-brand-graphite"
			>
				<span>Open source</span>
				<span>{mergedTotal} merged</span>
			</div>
			<div class="paper-scrap scrap-no-tape mt-3 overflow-hidden">
				{
					OPEN_SOURCE_REPOS.map((repo, index) => (
						<div
							class:list={[
								"px-3 py-3",
								index > 0 && "border-t border-dashed border-brand-ink/20",
							]}
						>
							<div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
								<a
									href={`/projects/${repo.projectSlug}`}
									class="text-sm font-black leading-tight text-brand-ink underline decoration-brand-green/30 decoration-2 underline-offset-4 transition-colors hover:decoration-brand-green"
								>
									{repo.name}
								</a>
								<a
									href={repo.url}
									target="_blank"
									rel="noopener noreferrer"
									class="font-mono text-[0.55rem] font-bold uppercase tracking-normal text-brand-graphite transition-colors hover:text-brand-green"
								>
									github ↗
								</a>
								<span class="ml-auto font-mono text-[0.55rem] font-bold uppercase tracking-normal text-brand-graphite">
									{repo.language} · {repo.pulls.length} merged
								</span>
							</div>
							<div class="mt-1.5">
								<PullRequestList pulls={repo.pulls} compact />
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
