---
const path = Astro.url.pathname.replace(/\/$/, "");
const isActive = (href: string) => {
  const base = href.replace(/\/$/, "");
  return base === "" ? path === "" : path === base || path.startsWith(base + "/");
};
---

<header class="bookmark-bar sticky top-0 z-50 h-0">
	<div
		class="pointer-events-none absolute inset-x-0 top-0 mx-auto flex max-w-7xl flex-nowrap items-start justify-between gap-2 px-5 sm:px-8 lg:px-12">
		<a href="/" class="brand-tag pointer-events-auto">
			<span class="hidden sm:inline">Fahridana.</span>
			<span class="sm:hidden">F.</span>
		</a>
		<nav
			aria-label="Sections"
			class="pointer-events-auto flex flex-nowrap items-start gap-1.5 font-mono text-[11px] font-black uppercase sm:text-xs">
			<a
				class:list={["bookmark", "bookmark-projects", { "is-active": isActive("/projects/") }]}
				href="/projects/"
				aria-current={isActive("/projects/") ? "page" : undefined}>
				Projects
			</a>
			<a
				class:list={["bookmark", "bookmark-art", { "is-active": isActive("/art/") }]}
				href="/art/"
				aria-current={isActive("/art/") ? "page" : undefined}>
				Art
			</a>
			<a
				class:list={["bookmark", "bookmark-notes", { "is-active": isActive("/blog/") }]}
				href="/blog/"
				aria-current={isActive("/blog/") ? "page" : undefined}>
				Notes
			</a>
		</nav>
	</div>
</header>

<style>
	.bookmark-bar {
		background: transparent;
		border: none;
		overflow: visible;
	}

	.brand-tag {
		margin-top: 0.55rem;
		padding: 0.3rem 0.7rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
			"Liberation Mono", monospace;
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--green);
		border: 2px solid var(--green);
		border-radius: 3px;
		outline: 1px solid var(--green);
		outline-offset: 2px;
		transform: rotate(-1.5deg);
		opacity: 0.9;
		white-space: nowrap;
		transition: transform 160ms ease, opacity 160ms ease, box-shadow 160ms ease;
	}

	.brand-tag:hover,
	.brand-tag:focus-visible {
		transform: rotate(0deg) translateY(1px);
		opacity: 1;
		box-shadow: 2px 2px 0 var(--green);
	}

	.bookmark {
		position: relative;
		padding: 0.7rem 0.75rem 1.45rem;
		color: var(--ink);
		background: var(--note);
		border: 1px solid rgba(36, 49, 42, 0.35);
		border-top: none;
		clip-path: polygon(
			0 0,
			100% 0,
			100% calc(100% - 9px),
			50% 100%,
			0 calc(100% - 9px)
		);
		transform: rotate(var(--tilt, 0deg));
		transform-origin: top center;
		filter: drop-shadow(0 1px 0 rgba(36, 49, 42, 0.35))
			drop-shadow(0 6px 6px rgba(36, 49, 42, 0.25));
		transition: padding 160ms ease, background 160ms ease, filter 160ms ease;
		white-space: nowrap;
	}

	.bookmark:hover,
	.bookmark:focus-visible {
		background: color-mix(in srgb, var(--note), var(--note-active) 60%);
		padding-top: 0.9rem;
		padding-bottom: 1.8rem;
		filter: drop-shadow(0 1px 0 rgba(36, 49, 42, 0.35))
			drop-shadow(0 10px 8px rgba(36, 49, 42, 0.28));
	}

	.bookmark.is-active {
		background: var(--note-active);
		padding-top: 1.15rem;
	}

	.bookmark-projects {
		--tilt: -1.4deg;
		--note: #d7f0ff;
		--note-active: #a5d8ff;
	}

	.bookmark-art {
		--tilt: 1.1deg;
		--note: #ffd9e6;
		--note-active: #ffafc9;
	}

	.bookmark-notes {
		--tilt: -0.8deg;
		--note: #f6f2a0;
		--note-active: #e7e15a;
	}

	@media (prefers-reduced-motion: reduce) {
		.bookmark {
			transition: background 160ms ease, filter 160ms ease;
		}

		.brand-tag {
			transition: box-shadow 160ms ease;
		}
	}
</style>
