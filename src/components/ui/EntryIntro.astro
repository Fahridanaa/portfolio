---
/**
 * First-visit entry animation. Ink is the default; ?intro=1 and ?intro=3
 * keep the other two directions available for comparison during development.
 *
 * The page is fully visible without JavaScript. A tiny classic script, loaded
 * by Layout.astro, sets data-intro on <html> before paint. Every rule below is
 * gated on that attribute, so a failed script leaves an ordinary usable page. The overlays
 * are decorative, ignore the pointer, and hide themselves when their CSS
 * animation ends.
 */
---

<div class="entry-overlay entry-cover" data-entry-overlay="1" aria-hidden="true">
	<div class="entry-cover-stage">
		<div class="entry-cover-book">
			<div class="entry-cover-face">
				<div class="entry-cover-label">
					<span class="entry-cover-tag">Fahridana.</span>
					<p class="entry-cover-title">portfolio</p>
					<p class="entry-cover-sub">a notebook in the web</p>
				</div>
				<p class="entry-cover-foot">notebook no. 01 &middot; opening</p>
				<span class="entry-cover-ribbon"></span>
			</div>
		</div>
	</div>
</div>

<div class="entry-overlay entry-swipe" data-entry-overlay="3" aria-hidden="true">
	<div class="entry-swipe-sheet">
		<span class="entry-swipe-stroke"></span>
	</div>
</div>


<style is:global>
	/* ------- shared ------- */

	.entry-overlay {
		position: fixed;
		inset: 0;
		z-index: 70;
		display: none;
		overflow: hidden;
		pointer-events: none;
	}

	html[data-intro="1"] .entry-overlay[data-entry-overlay="1"],
	html[data-intro="3"] .entry-overlay[data-entry-overlay="3"] {
		display: block;
	}

	/* The sheet is lifted in as the cover leaves, so the desk does not sit
	   empty behind the opening page. Both variants share the arrival. */
	@keyframes entry-sheet-in {
		from {
			opacity: 0;
			transform: translateY(1.4rem) scale(0.994);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	html[data-intro="1"] #main-content .notebook-sheet {
		animation: entry-sheet-in 720ms cubic-bezier(0.2, 0.8, 0.2, 1) 420ms both;
	}

	/* The blank sheet hides this fade; finishing it early keeps the page
	   crisp the moment the wipe uncovers it. */
	html[data-intro="3"] #main-content .notebook-sheet {
		animation: entry-sheet-in 420ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	/* ------- 1 · cover ------- */

	.entry-cover-stage {
		position: absolute;
		inset: 0;
		perspective: 1900px;
		perspective-origin: 16% 46%;
	}

	.entry-cover-book {
		position: absolute;
		inset: 0;
		transform-origin: 0 50%;
		transform-style: preserve-3d;
		animation: entry-cover-open 1280ms cubic-bezier(0.4, 0.05, 0.2, 1) 100ms
			both;
	}

	.entry-cover-face {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: clamp(2rem, 6vw, 5rem);
		color: #f7f5e8;
		background:
			var(--grain) 0 0 / 140px 140px,
			radial-gradient(
				circle at 76% 18%,
				rgba(201, 239, 106, 0.16),
				transparent 42%
			),
			linear-gradient(100deg, #213d29 0%, #2e5c37 46%, #274d30 100%);
		box-shadow:
			inset 1.1rem 0 2.4rem rgba(0, 0, 0, 0.38),
			inset 0 0 0 1px rgba(247, 245, 232, 0.08);
	}

	/* Paper block on the fore-edge: the closed book's page stack. */
	.entry-cover-face::after {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		width: 0.85rem;
		content: "";
		background: repeating-linear-gradient(
			180deg,
			#f7f5e8 0 2px,
			#d9d6c4 2px 3px,
			#f7f5e8 3px 5px
		);
		box-shadow: -1px 0 0 rgba(0, 0, 0, 0.35);
	}

	.entry-cover-label {
		margin-top: clamp(3rem, 16vh, 11rem);
		margin-left: clamp(0rem, 5vw, 5rem);
	}

	.entry-cover-tag {
		display: inline-block;
		padding: 0.42rem 0.9rem;
		border: 2px solid #f7f5e8;
		border-radius: 3px;
		outline: 1px solid rgba(247, 245, 232, 0.6);
		outline-offset: 3px;
		font-family:
			ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
			"Liberation Mono", monospace;
		font-size: 0.8rem;
		font-weight: 900;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		transform: rotate(-1.6deg);
	}

	.entry-cover-title {
		margin-top: clamp(1.6rem, 5vh, 3.4rem);
		font-size: clamp(2.6rem, 9vw, 7.5rem);
		font-weight: 900;
		line-height: 0.92;
		letter-spacing: -0.035em;
	}

	.entry-cover-sub {
		margin-top: 1.35rem;
		font-family:
			ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
			"Liberation Mono", monospace;
		font-size: clamp(0.7rem, 1.2vw, 0.85rem);
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgba(247, 245, 232, 0.62);
	}

	.entry-cover-foot {
		font-family:
			ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
			"Liberation Mono", monospace;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: rgba(247, 245, 232, 0.46);
	}

	.entry-cover-ribbon {
		position: absolute;
		top: 0;
		right: clamp(4rem, 18vw, 16rem);
		width: clamp(1.5rem, 2.6vw, 2.4rem);
		height: clamp(7rem, 26vh, 15rem);
		background: var(--highlighter);
		box-shadow:
			inset -0.35rem 0 0 rgba(46, 92, 55, 0.22),
			0 0 0 1px rgba(0, 0, 0, 0.12);
		clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 84%, 0 100%);
	}

	@keyframes entry-cover-open {
		0%,
		12% {
			opacity: 1;
			transform: rotateY(0deg) translateZ(0);
		}
		78% {
			opacity: 1;
			transform: rotateY(-92deg) translateZ(0);
		}
		100% {
			opacity: 0;
			visibility: hidden;
			transform: rotateY(-104deg) translateZ(0);
		}
	}

	/* ------- 2 · ink ------- */

	@keyframes entry-word-ink {
		from {
			opacity: 0;
			filter: blur(7px);
			transform: translateY(0.42em);
		}
		to {
			opacity: 1;
			filter: blur(0);
			transform: translateY(0);
		}
	}

	@keyframes entry-rise {
		from {
			opacity: 0;
			transform: translateY(0.9rem);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes entry-pop {
		from {
			opacity: 0;
			transform: translateY(0.55rem) scale(0.955);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes entry-mark-sweep {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	/* Inline-block from the first frame, so the heading never reflows when the
	   animation ends and the attribute is no longer involved. */
	.intro-word {
		display: inline-block;
	}

	html[data-intro="2"] [data-intro-step="name"] .intro-word {
		animation: entry-word-ink 640ms cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
	}

	html[data-intro="2"] [data-intro-step="name"] .intro-word:nth-child(1) {
		animation-delay: 90ms;
	}

	html[data-intro="2"] [data-intro-step="name"] .intro-word:nth-child(2) {
		animation-delay: 190ms;
	}

	html[data-intro="2"] [data-intro-step="name"] .intro-word:nth-child(3) {
		animation-delay: 290ms;
	}

	/* The paper arrives just before the writing does. */
	/* Transform only: the sheet holds the LCP text, so it must be painted from
	   the first frame. Fading it from opacity 0 delayed LCP by about a second. */
	@keyframes entry-sheet-settle {
		from {
			transform: translateY(1.4rem) scale(0.994);
		}
		to {
			transform: none;
		}
	}

	@keyframes entry-lift {
		from {
			transform: translateY(0.9rem);
		}
		to {
			transform: none;
		}
	}

	html[data-intro="2"] #main-content .notebook-sheet {
		animation: entry-sheet-settle 520ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	html[data-intro="2"] [data-intro-step="role"] {
		animation: entry-rise 540ms cubic-bezier(0.2, 0.8, 0.2, 1) 380ms
			backwards;
	}

	/* The pitch paragraph is the LCP element: no delay, no fade. */
	html[data-intro="2"] [data-intro-step="pitch"] {
		animation: entry-lift 560ms cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
	}

	html[data-intro="2"] [data-intro-step="actions"] {
		animation: entry-pop 560ms cubic-bezier(0.2, 1.25, 0.35, 1) 640ms backwards;
	}

	html[data-intro="2"] [data-intro-step="email"] {
		animation: entry-rise 480ms cubic-bezier(0.2, 0.8, 0.2, 1) 800ms backwards;
	}

	html[data-intro="2"] [data-intro-step="name"] .ink-underline::after {
		animation: entry-mark-sweep 500ms cubic-bezier(0.2, 0.8, 0.2, 1) 560ms
			backwards;
	}

	html[data-intro="2"] [data-intro-step="role"] .ink-underline::after {
		animation: entry-mark-sweep 460ms cubic-bezier(0.2, 0.8, 0.2, 1) 760ms
			backwards;
	}

	@keyframes entry-bookmark-drop {
		from {
			opacity: 0;
			transform: translateY(-0.9rem) rotate(0deg);
		}
		to {
			opacity: 1;
			transform: translateY(0) rotate(var(--tilt, 0deg));
		}
	}

	@keyframes entry-brand-in {
		from {
			opacity: 0;
			transform: translateY(-0.4rem) rotate(-1.5deg) scale(0.94);
		}
		to {
			opacity: 1;
			transform: translateY(0) rotate(-1.5deg) scale(1);
		}
	}

	html[data-intro="2"] [data-intro-step="brand"] {
		animation: entry-brand-in 480ms cubic-bezier(0.2, 1.1, 0.3, 1) 60ms backwards;
	}

	html[data-intro="2"] [data-intro-step="bookmark"] {
		animation: entry-bookmark-drop 620ms cubic-bezier(0.2, 1.3, 0.35, 1) backwards;
	}

	html[data-intro="2"] [data-intro-step="bookmark"]:nth-of-type(1) {
		animation-delay: 120ms;
	}

	html[data-intro="2"] [data-intro-step="bookmark"]:nth-of-type(2) {
		animation-delay: 190ms;
	}

	html[data-intro="2"] [data-intro-step="bookmark"]:nth-of-type(3) {
		animation-delay: 260ms;
	}

	/* ------- 3 · swipe ------- */

	.entry-swipe-sheet {
		position: absolute;
		inset: 0;
		overflow: hidden;
		background:
			var(--grain) 0 0 / 140px 140px,
			linear-gradient(90deg, rgba(46, 92, 55, 0.16) 1px, transparent 1px)
				clamp(2rem, 7vw, 5.5rem) 0 / 1px 100% no-repeat,
			linear-gradient(rgba(91, 126, 164, 0.2) 1px, transparent 1px) 0 2rem /
				100% 2.4rem,
			var(--paper-warm);
		box-shadow: -1.6rem 0 2.6rem rgba(36, 49, 42, 0.26);
		animation: entry-swipe-away 700ms cubic-bezier(0.38, 0.04, 0.2, 1) 440ms
			both;
	}

	.entry-swipe-stroke {
		position: absolute;
		top: 26%;
		left: -70vw;
		width: 62vw;
		height: 30vh;
		border-radius: 999px;
		background: linear-gradient(
			90deg,
			rgba(201, 239, 106, 0) 0%,
			rgba(201, 239, 106, 0.92) 12%,
			rgba(201, 239, 106, 0.92) 82%,
			rgba(201, 239, 106, 0) 100%
		);
		transform: rotate(-7deg);
		mix-blend-mode: multiply;
		animation: entry-swipe-stroke 560ms cubic-bezier(0.55, 0.05, 0.25, 1) 60ms
			both;
	}

	@keyframes entry-swipe-stroke {
		from {
			transform: translateX(0) rotate(-7deg);
		}
		to {
			transform: translateX(230vw) rotate(-7deg);
		}
	}

	@keyframes entry-swipe-away {
		0%,
		8% {
			transform: translateX(0) rotate(0deg);
		}
		100% {
			transform: translateX(103%) rotate(0.5deg);
			visibility: hidden;
		}
	}

	/* ------- motion and fallbacks ------- */

	@media (prefers-reduced-motion: reduce) {
		.entry-overlay {
			display: none !important;
		}
	}
</style>
