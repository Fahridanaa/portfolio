---
import { formatBlogDate, type BlogEntry } from "@/utils/blog";

interface Props {
	older?: BlogEntry;
	newer?: BlogEntry;
}

const { older, newer } = Astro.props;
---

{
	(older || newer) && (
		<nav
			aria-label="More notes"
			class="mt-14 grid gap-4 border-t border-brand-ink/15 pt-6 sm:grid-cols-2"
		>
			{older ? (
				<a
					href={`/blog/${older.id}/`}
					class="group flex flex-col gap-1 border border-brand-ink/15 bg-brand-paper/55 p-4 transition-colors hover:border-brand-green/40 hover:bg-brand-highlighter/30"
				>
					<span class="flex items-center gap-1.5 font-mono text-xs font-bold uppercase tracking-normal text-brand-graphite">
						<svg
							viewBox="0 0 24 24"
							width="14"
							height="14"
							fill="none"
							stroke="currentColor"
							stroke-width="3"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							focusable="false"
						>
							<path d="m15 18-6-6 6-6"></path>
						</svg>
						Older note
					</span>
					<span class="text-pretty text-lg font-black leading-tight text-brand-ink group-hover:text-brand-green">
						{older.data.title}
					</span>
					<time
						datetime={older.data.date.toISOString()}
						class="font-mono text-xs font-semibold text-brand-graphite"
					>
						{formatBlogDate(older.data.date)}
					</time>
				</a>
			) : (
				<span aria-hidden="true"></span>
			)}
			{newer ? (
				<a
					href={`/blog/${newer.id}/`}
					class="group flex flex-col gap-1 border border-brand-ink/15 bg-brand-paper/55 p-4 transition-colors hover:border-brand-green/40 hover:bg-brand-highlighter/30 sm:col-start-2 sm:items-end sm:text-right"
				>
					<span class="flex items-center gap-1.5 font-mono text-xs font-bold uppercase tracking-normal text-brand-graphite">
						Newer note
						<svg
							viewBox="0 0 24 24"
							width="14"
							height="14"
							fill="none"
							stroke="currentColor"
							stroke-width="3"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							focusable="false"
						>
							<path d="m9 18 6-6-6-6"></path>
						</svg>
					</span>
					<span class="text-pretty text-lg font-black leading-tight text-brand-ink group-hover:text-brand-green">
						{newer.data.title}
					</span>
					<time
						datetime={newer.data.date.toISOString()}
						class="font-mono text-xs font-semibold text-brand-graphite"
					>
						{formatBlogDate(newer.data.date)}
					</time>
				</a>
			) : null}
		</nav>
	)
}
