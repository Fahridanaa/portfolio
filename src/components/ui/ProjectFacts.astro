---
import type { ProjectMeta } from "@/models/project";
import ProjectButton from "@/components/ui/ProjectButton.astro";
import TechStack from "@/components/ui/TechStack.astro";

interface Props {
	frontmatter: ProjectMeta;
}

const { frontmatter } = Astro.props;
const sourceLabel =
	frontmatter.group === "open-source" ? "Repository" : "Client";
---

<div>
	<p class="sketch-label mb-2 text-xs">links</p>
	<div class="flex flex-wrap gap-2">
		{frontmatter.demo && (
			<ProjectButton href={frontmatter.demo} icon="external" text="Demo" />
		)}
		{frontmatter.sourceClient && (
			<ProjectButton href={frontmatter.sourceClient} icon="code" text={sourceLabel} />
		)}
		{frontmatter.sourceServer && (
			<ProjectButton href={frontmatter.sourceServer} icon="code" text="API" />
		)}
	</div>
</div>
<div>
	<p class="sketch-label mb-2 text-xs">stack</p>
	<div class="flex flex-wrap gap-2">
		{frontmatter.stack.map((tech: string) => (
			<TechStack tech={tech} size="small" isLazy={false} />
		))}
	</div>
</div>
