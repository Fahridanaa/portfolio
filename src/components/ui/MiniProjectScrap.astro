---
import type { ProjectMeta } from "@/models/project";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	project: ProjectMeta;
	slug: string;
	mergedPrs?: number;
}

const { project, slug, mergedPrs } = Astro.props;
const { title, type, stack, description, date } = project;
const visibleTech = stack.slice(0, 4);
const hiddenTechCount = stack.length - visibleTech.length;
const projectDateStr = date.toLocaleDateString("en-US", {
	month: "short",
	year: "numeric",
});

const covers = import.meta.glob<{ default: ImageMetadata }>(
	"/public/assets/projects/*/cover.webp",
	{ eager: true }
);
const cover = covers[`/public/assets/projects/${slug}/cover.webp`]?.default;
---

<a
	href={`/projects/${slug}/`}
	class="paper-scrap paper-lift group flex flex-col gap-2 p-4"
>
	{cover && (
		<div class="-mx-4 -mt-4 overflow-hidden rounded-t-[2px]">
			<Image
				src={cover}
				alt=""
				loading="lazy"
				width={640}
				height={320}
				class="depth-media block w-full"
			/>
		</div>
	)}
	<h3
		class="text-pretty text-base font-black leading-tight text-brand-ink sm:text-lg"
	>
		{title}
	</h3>

	<div class="flex flex-wrap items-center gap-2">
		<p class="sketch-label text-xs">{type}</p>
		<span
			class="font-mono text-xs font-bold uppercase tracking-normal text-brand-graphite"
		>
			{projectDateStr}
		</span>
		{mergedPrs !== undefined && (
			<span class="ml-auto font-mono text-xs font-bold uppercase tracking-normal text-brand-green">
				{mergedPrs} merged PRs
			</span>
		)}
	</div>

	<p
		class="line-clamp-2 text-sm leading-relaxed text-brand-graphite"
	>
		{description}
	</p>

	<div class="mt-auto flex flex-wrap gap-1.5">
		{visibleTech.map((tech) => (
			<span
				class="depth-chip rounded-sm bg-brand-paper/80 px-1.5 py-0.5 font-mono text-xs font-bold uppercase tracking-normal text-brand-ink"
			>
				{tech}
			</span>
		))}
		{hiddenTechCount > 0 && (
			<span
				class="depth-chip rounded-sm bg-brand-green-soft px-1.5 py-0.5 font-mono text-xs font-bold uppercase tracking-normal text-brand-green"
			>
				+{hiddenTechCount}
			</span>
		)}
	</div>
</a>
