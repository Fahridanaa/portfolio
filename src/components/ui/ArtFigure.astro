---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	image: ImageMetadata;
	animated?: boolean;
	caption: string;
}

const { image, animated = false, caption } = Astro.props;
---

<figure class="camera-print max-w-sm self-start">
	<span class="camera-pin" aria-hidden="true"></span>
	{
		animated ? (
			<img
				src={image.src}
				alt={caption}
				loading="lazy"
				class="pixelated w-full rounded-sm object-cover"
			/>
		) : (
			<Image
				src={image}
				alt={caption}
				loading="lazy"
				class="w-full rounded-sm object-cover"
			/>
		)
	}
	<figcaption class="camera-caption">{caption}</figcaption>
</figure>
