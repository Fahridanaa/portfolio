---
import type { ExperienceMeta } from "@/models/experience";

interface Props {
  experience: ExperienceMeta;
}

const { experience } = Astro.props;

const monthYear = new Intl.DateTimeFormat("en", {
  month: "short",
  year: "numeric",
});
const formatMonthYear = (date: Date) => monthYear.format(date);

const startLabel = formatMonthYear(experience.startDate);
const endLabel = formatMonthYear(experience.endDate);
---

<details class="experience-entry" open>
  <summary class="experience-row">
    <span class="experience-rail" aria-hidden="true">
      <span class="experience-dot"></span>
    </span>

    <img
      src={experience.logo}
      alt={`${experience.company} logo`}
      width="44"
      height="44"
      class="depth-media h-11 w-11 shrink-0 rounded-md bg-white p-1.5 object-contain"
    />

    <div class="flex min-w-0 flex-col justify-between gap-1 sm:flex-row sm:items-center sm:gap-4">
      <div class="min-w-0">
        <div class="flex flex-col gap-0.5 sm:flex-row sm:items-center sm:gap-2">
          <h3 class="truncate text-base font-black leading-tight text-brand-ink sm:text-lg">
            {experience.company}
          </h3>
          <div class="flex flex-row flex-wrap gap-1.5">
            <span class="shrink-0 rounded-sm bg-brand-green-soft/80 px-2 py-0.5 font-mono text-xs font-bold uppercase tracking-normal text-brand-green">
              {experience.type}
            </span>
            <span class="shrink-0 rounded-sm bg-white/60 px-2 py-0.5 font-mono text-xs font-bold uppercase tracking-normal text-brand-graphite ring-1 ring-brand-green/10">
              {experience.isRemote ? "Remote" : "OnSite"}
            </span>
          </div>
        </div>
        <p class="mt-1 flex flex-col text-sm font-semibold text-brand-graphite sm:flex-row sm:items-center sm:truncate">
          <span class="text-brand-green">{experience.role}</span>
          <span class="mx-1.5 hidden sm:inline">•</span>
          {experience.location}
        </p>
      </div>
      <span class="experience-period shrink-0 text-left sm:text-center">
        <time datetime={experience.startDate.toISOString()}>{startLabel}</time>
        <span aria-hidden="true"> – </span>
        <span class="sr-only">to</span>
        <time datetime={experience.endDate.toISOString()}>{endLabel}</time>
      </span>
    </div>

    <span class="experience-cue" aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </span>
  </summary>

  <div class="experience-note">
    <div aria-hidden="true"></div>
    <div aria-hidden="true" class="w-11"></div>
    <div class="flex flex-col gap-6">
      <ul data-reveal-stagger class="min-w-0 list-inside list-disc space-y-1 text-base leading-relaxed text-brand-graphite">
        {experience.bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>

      {
        experience.techStack.length > 0 && (
          <div data-reveal-stagger class="flex flex-wrap gap-2">
            {experience.techStack.map((tech) => (
              <span class="depth-chip rounded-sm bg-brand-paper/80 px-2 py-1 font-mono text-xs font-bold uppercase tracking-normal text-brand-ink">
                {tech}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</details>

<script>
	// Opening and closing a role animates the note instead of snapping it.
	// <details> cannot animate its own height, so the click is handled here:
	// open the element, then animate the note from 0 to its height (or the
	// reverse, then close). Reduced motion and no JS keep the native toggle.
	const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
	const busy = new WeakSet<HTMLDetailsElement>();

	document.addEventListener("click", (event) => {
		const row = (event.target as Element).closest<HTMLElement>(
			".experience-row",
		);
		const entry = row?.parentElement;
		if (!(entry instanceof HTMLDetailsElement)) return;
		const note = entry.querySelector<HTMLElement>(".experience-note");
		if (!note || reduceMotion.matches) return;

		event.preventDefault();
		if (busy.has(entry)) return;
		busy.add(entry);
		note.style.overflow = "hidden";

		const finish = () => {
			note.style.overflow = "";
			busy.delete(entry);
		};

		if (!entry.open) {
			entry.open = true;
			const height = note.offsetHeight;
			note.animate(
				[
					{ height: "0px", opacity: 0 },
					{ height: `${height}px`, opacity: 1 },
				],
				{ duration: 420, easing: "cubic-bezier(0.2, 0.8, 0.2, 1)" },
			).onfinish = finish;

			// Bullets slide in and tech chips pop, one after another.
			note.querySelectorAll("li, .depth-chip").forEach((el, i) => {
				el.animate(
					[
						{ opacity: 0, transform: "translateY(0.55rem) scale(0.94)" },
						{ opacity: 1, transform: "none" },
					],
					{
						duration: 460,
						delay: 140 + i * 55,
						easing: "cubic-bezier(0.2, 1.3, 0.4, 1)",
						fill: "backwards",
					},
				);
			});
		} else {
			// The chevron turns back at once; the note folds, then closes.
			entry.dataset.closing = "";
			const fold = note.animate(
				[
					{ height: `${note.offsetHeight}px`, opacity: 1 },
					{ height: "0px", opacity: 0 },
				],
				{
					duration: 200,
					easing: "cubic-bezier(0.4, 0, 0.6, 1)",
					fill: "forwards",
				},
			);
			fold.onfinish = () => {
				entry.open = false;
				delete entry.dataset.closing;
				fold.cancel();
				finish();
			};
		}
	});
</script>
