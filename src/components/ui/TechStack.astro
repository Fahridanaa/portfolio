---
import { techIconSvg } from "@/utils/icons";

interface Props {
	tech: string;
	size: "small" | "medium" | "large";
	isLazy?: boolean;
	title?: string;
}

const { tech, size, title } = Astro.props;
const svg = techIconSvg(tech);
---

<div
	class={`paper-lift depth-control flex flex-col items-center justify-center gap-2 rounded-md bg-white/70 text-brand-ink ${size === "small" ? "px-2 py-1" : ""} ${size === "medium" ? "px-3 py-2" : ""} ${size === "large" ? "px-4 py-3 sm:px-6" : ""}`}
	title={title ? title : tech}>
	{
		svg && (
			<div class={`tech-svg ${size}`}>
				<Fragment set:html={svg} />
			</div>
		)
	}
	<p
		class={`text-center font-black uppercase tracking-normal ${size === "small" ? "text-[0.65rem]" : ""} ${size === "medium" ? "text-xs" : ""} ${size === "large" ? "text-sm" : ""}`}>
		{tech}
	</p>
</div>

<style>
	.tech-svg.small {
		width: 32px;
		height: 32px;
	}
	.tech-svg.medium {
		width: 40px;
		height: 40px;
	}
	.tech-svg.large {
		width: 64px;
		height: 64px;
	}
	.tech-svg svg {
		width: 100%;
		height: 100%;
		transition: transform 200ms ease;
	}
	.tech-svg:hover svg {
		transform: rotate(3deg);
	}
</style>
